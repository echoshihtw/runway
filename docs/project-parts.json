{
  "repository_type": "monorepo",
  "tooling": { "workspace": "dart pub workspace", "orchestrator": "melos 7.5.1", "task_runner": "Makefile" },
  "parts": [
    {
      "part_id": "domain",
      "display_name": "Domain (pure Dart core)",
      "root_path": "packages/domain",
      "project_type_id": "library",
      "language": "Dart",
      "flutter_dependency": false,
      "internal_dependencies": [],
      "key_external": ["fpdart"],
      "entry_point": "lib/domain.dart",
      "critical_files": ["lib/logic/survival_engine.dart", "lib/logic/monthly_aggregator.dart", "lib/repositories/"],
      "tests": { "path": "test/", "count": 6, "kind": "unit", "requires_device": false }
    },
    {
      "part_id": "data",
      "display_name": "Data (Drift + SQLCipher)",
      "root_path": "packages/data",
      "project_type_id": "library",
      "language": "Dart/Flutter",
      "flutter_dependency": true,
      "internal_dependencies": ["domain"],
      "key_external": ["drift", "sqlcipher_flutter_libs", "flutter_secure_storage", "sqlite3", "path_provider"],
      "entry_point": "lib/data.dart",
      "critical_files": ["lib/database/app_database.dart", "lib/tables/", "lib/repositories/"],
      "tests": { "path": "test/integration/", "count": 3, "kind": "integration", "requires_device": false }
    },
    {
      "part_id": "application",
      "display_name": "Application (Riverpod providers + use cases)",
      "root_path": "packages/application",
      "project_type_id": "library",
      "language": "Dart/Flutter",
      "flutter_dependency": true,
      "internal_dependencies": ["domain"],
      "key_external": ["flutter_riverpod", "riverpod_annotation", "shared_preferences"],
      "entry_point": "lib/application.dart",
      "critical_files": ["lib/providers/model_provider.dart", "lib/providers/entitlement_provider.dart", "lib/use_cases/"],
      "tests": { "path": "test/use_cases/", "count": 2, "kind": "unit", "requires_device": false }
    },
    {
      "part_id": "design_system",
      "display_name": "Design System (tokens, theme, components, l10n)",
      "root_path": "packages/design_system",
      "project_type_id": "library",
      "language": "Dart/Flutter",
      "flutter_dependency": true,
      "internal_dependencies": [],
      "key_external": ["google_fonts", "intl", "flutter_localizations"],
      "entry_point": "lib/design_system.dart",
      "critical_files": ["lib/tokens/app_semantic_colors.dart", "lib/theme/app_theme.dart", "lib/l10n/"],
      "tests": { "path": null, "count": 0, "kind": null, "requires_device": false }
    },
    {
      "part_id": "presentation",
      "display_name": "Presentation (screens + widgets)",
      "root_path": "packages/presentation",
      "project_type_id": "library",
      "language": "Dart/Flutter",
      "flutter_dependency": true,
      "internal_dependencies": ["application", "design_system", "domain"],
      "key_external": ["go_router", "fl_chart", "intl", "uuid", "share_plus"],
      "entry_point": "lib/router/app_router.dart",
      "critical_files": ["lib/router/app_router.dart", "lib/features/dashboard/", "lib/features/paywall/paywall_screen.dart"],
      "tests": { "path": null, "count": 0, "kind": null, "requires_device": false }
    },
    {
      "part_id": "app",
      "display_name": "App (composition root + native projects)",
      "root_path": "app",
      "project_type_id": "mobile",
      "language": "Dart/Flutter",
      "flutter_dependency": true,
      "internal_dependencies": ["presentation", "application", "data", "domain", "design_system"],
      "key_external": ["firebase_core", "firebase_analytics", "purchases_flutter", "flutter_windowmanager_plus", "screenshot"],
      "entry_point": "lib/main.dart",
      "critical_files": ["lib/main.dart", "lib/revenuecat_service.dart", "lib/firebase_options.dart"],
      "tests": { "path": "test/ + integration_test/", "count": 3, "kind": "widget + e2e", "requires_device": true },
      "platform_identifiers": {
        "ios_bundle_id": "com.silverfern.survivaloptimizer",
        "android_application_id": "com.survival.app",
        "note": "iOS and Android ship under different identifiers; Makefile APP_ID matches iOS only"
      }
    }
  ],
  "layer_rule": "presentation -> application -> domain <- data ; design_system is a leaf; app wires all six",
  "integration_points": [
    {
      "from": "app",
      "to": "application",
      "type": "Dependency Injection",
      "details": "ProviderScope(overrides:) in app/lib/main.dart binds DriftTransactionRepository, DriftLoanRepository, DriftSubscriptionRepository, RevenueCatService, and FirebaseAnalyticsService to placeholder providers that otherwise throw UnimplementedError"
    },
    {
      "from": "data",
      "to": "domain",
      "type": "Interface Implementation",
      "details": "Drift*Repository implements domain.*Repository; Drift row classes converted by mapper extensions at the boundary so ORM types never leak inward"
    },
    {
      "from": "application",
      "to": "domain",
      "type": "Direct Function Calls",
      "details": "modelProvider composes aggregateMonths + computeModel; loan/subscription providers call the corresponding pure engines"
    },
    {
      "from": "presentation",
      "to": "application",
      "type": "Riverpod ref.watch / ref.read",
      "details": "Reads providers for display; writes via *UseCaseProvider.execute(entity)"
    },
    {
      "from": "presentation",
      "to": "design_system",
      "type": "Widget + Token Imports",
      "details": "Neo/Terminal components, SC/AppColors tokens, AppSpacing, AppTextStyles, and context.l10n localizations"
    },
    {
      "from": "data",
      "to": "presentation",
      "type": "Reactive Stream",
      "details": "Drift watch() -> StreamProvider -> ConsumerWidget rebuild; a single write propagates to the hero runway number with no manual refresh"
    }
  ],
  "external_services": [
    { "name": "Firebase Analytics", "required": false, "note": "init failure is caught and ignored; NoOpAnalytics is the fallback" },
    { "name": "RevenueCat", "required": false, "note": "disabled while kRevenueCatGoogleKey is a placeholder; isRevenueCatConfigured requires both keys" }
  ],
  "backend": null
}
